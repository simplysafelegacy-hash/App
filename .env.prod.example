# Simply Safe Legacy — PRODUCTION deploy target (app.simplysafelegacy.com).
# Copy to .env.prod and fill in. Used by:
#   ./deploy/deploy.sh --prod    (first-time provision of the app VM)
#   ./deploy/update.sh --prod    (every subsequent code + schema push)
#
# .env.prod is gitignored. Keep the real one out of the repo.
#
# ── Topology ──────────────────────────────────────────────────────────────
# Production runs on TWO VMs:
#
#   app VM   caddy + frontend + backend  (docker compose lives here)
#   db  VM   postgres                    (already provisioned separately)
#
# The app VM starts NO postgres container. In docker-compose.yml the
# postgres service sits behind the "localdb" compose profile, and the
# deploy script pins COMPOSE_PROFILES='' on the app VM so that profile is
# never enabled. The backend connects out to POSTGRES_HOST below.

# ── Database (on the dedicated database VM) ───────────────────────────────
# Point this at the DB VM's address — prefer the private/VPC IP so Postgres
# never needs to listen on the public internet.
POSTGRES_HOST=10.0.0.5
POSTGRES_REMOTE_PORT=5432
POSTGRES_USER=simplysafelegacy
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=simplysafelegacy

# require  → TLS enforced (recommended; needs TLS configured on the DB VM)
# disable  → plaintext; only acceptable on a trusted private network
POSTGRES_SSLMODE=require

# Must stay empty in production — this is what keeps a postgres container
# from being started on the app VM. deploy/update.sh pins it anyway.
COMPOSE_PROFILES=

# ── Schema migrations ─────────────────────────────────────────────────────
# Migrations are embedded in the Go binary and applied at boot, in lexical
# order, recorded in schema_migrations. Deploying new code therefore
# deploys the schema changes with it.
#
#   true   apply pending migrations on backend startup (default)
#   false  connect only; leave the schema untouched
#
# Set false when you want to push code without a schema change, or to
# migrate deliberately from one place before rolling out.
RUN_MIGRATIONS=true

# ── Backend ───────────────────────────────────────────────────────────────
APP_ENV=production
BACKEND_PORT=8080
# Generate a fresh one — do NOT reuse the dev secret:
#   openssl rand -base64 48
JWT_SECRET=CHANGE-ME-at-least-32-characters-long-random-string
JWT_EXPIRY=168h

# ── Public-facing app URL ─────────────────────────────────────────────────
# The deploy script overwrites these on the remote .env to match
# CADDY_DOMAIN, so they exist here mainly for documentation.
PUBLIC_APP_URL=https://app.simplysafelegacy.com
ALLOWED_ORIGINS=https://app.simplysafelegacy.com
CADDY_DOMAIN=app.simplysafelegacy.com

# ── Google OAuth (required) ───────────────────────────────────────────────
# The production client must list https://app.simplysafelegacy.com as an
# authorized JavaScript origin and redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (LIVE keys for production) ─────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
# From the Stripe dashboard webhook endpoint pointed at
# https://app.simplysafelegacy.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_INDIVIDUAL=price_
STRIPE_PRICE_FAMILY=price_
STRIPE_PRICE_SAFEKEEPING=price_
STRIPE_TRIAL_DAYS=14

# ── Object storage (Amazon S3) ───────────────────────────────────────────
# Vault documents and release-request proof files.
#
# NO AWS CREDENTIALS BELONG IN THIS FILE. The app VM runs with an EC2
# instance profile, so the SDK fetches short-lived credentials from the
# instance metadata service and rotates them automatically. Nothing to
# store, nothing to leak, nothing to rotate by hand. See the "Object
# storage" runbook in README.md for the IAM policy and bucket hardening.
S3_BUCKET=ssl-prod-vault-documents
AWS_REGION=us-east-1

# Customer-managed KMS key for SSE-KMS. Strongly recommended: it gives you
# a key you control, a CloudTrail audit trail of every decrypt, and the
# ability to revoke access to the data by revoking the key. Leave empty to
# fall back to the bucket's default encryption (still encrypted at rest,
# but with an AWS-managed key).
S3_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/CHANGE-ME

# Local S3-compatible testing only (MinIO/LocalStack). Leave empty in prod.
S3_ENDPOINT=
S3_PATH_STYLE=false

# ── Support email ─────────────────────────────────────────────────────────
SUPPORT_EMAIL_TO=simplysafelegacy@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend ──────────────────────────────────────────────────────────────
FRONTEND_PORT=8000
VITE_GOOGLE_CLIENT_ID=
