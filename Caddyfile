# Caddyfile for Simply Safe Legacy.
#
# Caddy reads CADDY_DOMAIN from the environment (set in .env) and serves
# the SPA + reverse-proxies /api to the Go backend with automatic HTTPS
# via Let's Encrypt.
#
# DNS prerequisite: an A record for {$CADDY_DOMAIN} must point at the VM's
# public IP before Caddy can complete the ACME challenge.

{$CADDY_DOMAIN} {
    encode zstd gzip

    # API + Stripe webhook → Go backend.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Everything else → the static SPA.
    handle {
        reverse_proxy frontend:80
    }

    # Modest security baseline. The frontend doesn't need referrer leaks
    # to third parties; the SPA never embeds anyone else.
    #
    # frame-ancestors / X-Frame-Options are the clickjacking defence: nothing
    # legitimately frames this app (Auth0 is a redirect, Stripe Checkout is a
    # redirect), so framing it at all means someone is overlaying the vault's
    # release control on a page of their own. frame-ancestors governs who may
    # frame US and does not affect the iframe the Auth0 SDK opens.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
